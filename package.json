{
  "name": "agrifintech-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "AgriFintech Operating System - KrishiNetra 2.0 Architecture",
  "scripts": {
    "start:frontend": "npm --prefix frontend start",
    "start:backend": "npm --prefix backend run dev",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "test": "npm run test:frontend && npm run test:backend",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:backend"
  }
}
