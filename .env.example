# Environment Configuration Template
# AgriFintech Operating System (KrishiNetra 2.0 Architecture)

# ============================================================
# Backend Environment Variables
# ============================================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006,exp://*

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# ============================================================
# Frontend Environment Variables (Expo / React Native)
# ============================================================
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional Integrations for Future Phases
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
# GEMINI_API_KEY=your-gemini-key
# SARVAM_API_KEY=your-sarvam-key
