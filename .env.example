# Environment Configuration Template
# AgriFintech Operating System (KrishiNetra 2.0 Architecture)

# ============================================================
# Backend Environment Variables
# ============================================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key

# Database Mode Toggle (true for live Supabase, false for local in-memory store)
SUPABASE_ENABLED=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Intelligence & ML Engine
APP_DATA_MODE=mock
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_KEY=
MARKET_DATA_BASE_URL=https://api.data.gov.in
MARKET_DATA_API_KEY=
INTELLIGENCE_CACHE_TTL=900
INTELLIGENCE_REFRESH_LIMIT=60

# ============================================================
# Frontend Environment Variables (Expo / React Native)
# ============================================================
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional Integrations for Future Phases
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
# GEMINI_API_KEY=your-gemini-key
# SARVAM_API_KEY=your-sarvam-key
